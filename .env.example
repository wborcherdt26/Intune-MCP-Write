# Azure AD App Registration
# This app registration requires the following delegated permissions:
#   DeviceManagementManagedDevices.ReadWrite.All
#   DeviceManagementManagedDevices.PrivilegedOperations.All
#   Device.Read.All
#   GroupMember.ReadWrite.All
#   Directory.Read.All
#   User.Read.All
#
# WARNING: PrivilegedOperations.All grants the ability to remotely wipe, retire,
# restart, and lock any managed device the authenticated user has Intune RBAC
# access to. Use Intune scope tags to limit which devices can be acted on.
# Admin consent is required for this permission.
AZURE_CLIENT_ID=your-app-client-id
AZURE_TENANT_ID=your-tenant-id

# Set to "true" to enable destructive remote actions (retire, wipe, delete).
# When not set or set to any other value, these tools will not be registered.
# ENABLE_DESTRUCTIVE_ACTIONS=true
