{
  "name": "intune-mcp-write",
  "version": "1.5.0",
  "description": "MCP server providing read-write access to Microsoft Intune device properties and group memberships via Graph API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "intune-mcp-write": "dist/index.js",
    "intune-mcp-write-auth": "dist/auth-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"if(process.platform!=='win32'){const fs=require('fs');['dist/index.js','dist/auth-cli.js'].forEach(f=>{try{fs.chmodSync(f,0o755)}catch{}})}\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "auth": "node dist/auth-cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
